# Database connection string (PostgreSQL with psycopg v3 driver)
# Cloud providers like Render/Supabase/Neon often provide 'postgres://' or 'postgresql://'
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/Url_Shortner

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# Example: http://localhost:3000,https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
